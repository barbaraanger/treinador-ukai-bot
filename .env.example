DISCORD_TOKEN=
DISCORD_CLIENT_ID=
METRICS_CHANNEL_ID=1553061916904259634
GROQ_API_KEY=
# Opcional: ID do servidor para registrar comandos imediatamente no servidor de teste.
DISCORD_GUILD_ID=
# O Large v3 prioriza precisão; use whisper-large-v3-turbo para menor custo/latência.
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Opcional; contexto para nomes e termos específicos da conversa (limite de 224 tokens).
GROQ_TRANSCRIPTION_PROMPT=
# Opcional; modelo de chat usado para criar o título-resumo da thread.
GROQ_SUMMARY_MODEL=openai/gpt-oss-20b
